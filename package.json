{
  "name": "factoryengineering",
  "version": "0.0.2",
  "description": "Factory Engineering website built using DocKit, Starlight, Astro, and Tailwind CSS",
  "author": "Michael L Perry",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build:anims": "node tools/chat-anim/render.js --glob '{chat-anims,src/content/docs}/**/*.chat.yaml'",
    "build": "yarn build:anims && astro build && node scripts/export-markdown.mjs",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.37.0",
    "@astrojs/starlight-tailwind": "^4.0.2",
    "@tailwindcss/vite": "^4.1.17",
    "astro": "^5.16.4",
    "astro-embed": "^0.9.2",
    "astro-font": "^1.1.0",
    "marked": "^17.0.1",
    "sharp": "^0.34.5",
    "vite": "^7.2.6"
  },
  "devDependencies": {
    "astro-vtbot": "^2.1.9",
    "glob": "^10.3.10",
    "handlebars": "^4.7.8",
    "js-yaml": "^4.1.0",
    "puppeteer": "^23.0.0",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3"
  }
}
